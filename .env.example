# FormEase — Environment Configuration Template
# Copy this file to .env and populate the required keys.

# ==============================================================================
# 1. APPLICATION & SERVER CONFIGURATION
# ==============================================================================
PROJECT_NAME="FormEase"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"
BACKEND_HOST="0.0.0.0"
BACKEND_PORT=8000
FRONTEND_URL="http://localhost:3000"

# CORS configuration (comma-separated origins)
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,https://formease-virid.vercel.app"

# ==============================================================================
# 2. SUPABASE CONFIGURATION (Database, Auth, Storage)
# ==============================================================================
# Retrieve these from your Supabase project settings. The anon/publishable key is public.
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_ANON_KEY="your-anon-public-key"
# Server-only service role key for worker and background pipeline tasks
SUPABASE_SERVICE_ROLE_KEY="your-service-role-private-key"
# Needed only when your project still signs user tokens with legacy HS256.
# RS256/ES256 projects use the project's public JWKS endpoint instead.
SUPABASE_JWT_SECRET="your-legacy-jwt-secret"
SUPABASE_STORAGE_BUCKET="documents"

# ==============================================================================
# 3. AI INFERENCE (OpenRouter by default; Ollama remains available locally)
# ==============================================================================
# Keep the OpenRouter credential on the backend only. Do not use NEXT_PUBLIC_ for it.
AI_PROVIDER="openrouter"
OPENROUTER_API_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_API_KEY="your-openrouter-api-key"
OPENROUTER_MODEL="your-openrouter-model-id"
OPENROUTER_FREE_FALLBACK_MODELS="baidu/ernie-5.5-flash-preview:free"
OPENROUTER_TIMEOUT_SECONDS=90
AI_REQUEST_INTERVAL_SECONDS=3.5
AI_MAX_RETRIES=2
AI_QUEUE_CONCURRENCY=1
AI_ANALYSIS_BATCH_CHARS=10000
OCR_ENABLED=true
OCR_LANGUAGE=eng+hin
OCR_MIN_TEXT_CHARS=40
AI_USER_CHAT_REQUESTS_PER_MINUTE=10

# Optional local Ollama configuration when AI_PROVIDER="ollama".
# Default local Ollama host endpoint (must NOT be exposed directly to browsers)
OLLAMA_BASE_URL="http://127.0.0.1:11434"

# Selected fixed model (Selected following 1B–4B benchmark for CPU efficiency)
# Candidate tested: llama3.2 (3B Q4) or mistral (7B Q4) or qwen2.5:3b
OLLAMA_MODEL="llama3.2:latest"
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_MAX_RETRIES=3

# ==============================================================================
# 4. DOCUMENT PROCESSING & RETRIEVAL CONFIGURATION
# ==============================================================================
MAX_UPLOAD_SIZE_MB=100
SUPPORTED_FILE_EXTENSIONS="pdf,docx,txt"
DEFAULT_CHUNK_SIZE=700
DEFAULT_CHUNK_OVERLAP=90
TFIDF_MAX_FEATURES=5000
TFIDF_RELEVANCE_THRESHOLD=0.18

# Processing queue settings
MAX_CONCURRENT_JOBS=2
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_RETRIES=3

# Retention for Recently Deleted (in days)
TRASH_RETENTION_DAYS=30
